# React Native's native builds launch helper scripts from inside node_modules, and
# Windows cannot start a process whose path exceeds 260 characters — a limit that
# LongPathsEnabled does not lift, because it does not apply to CreateProcess.
#
# pnpm's default layout nests packages under .pnpm/<name>@<version>_<hash>/, which
# alone accounts for ~140 characters and pushed the CMake helper scripts to 289.
# Hoisting brings the same path to 146.
node-linker=hoisted
