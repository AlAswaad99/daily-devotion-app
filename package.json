{
  "name": "abide",
  "private": true,
  "packageManager": "pnpm@9.14.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint",
    "check:offline": "node scripts/check-offline-sync.mjs",
    "dev:reset": "pnpm db:reset && pnpm --filter @abide/content content:import && node scripts/seed-demo-progress.mjs",
    "dev:demo": "node scripts/seed-demo-progress.mjs",
    "content:import": "pnpm --filter @abide/content content:import",
    "check:admin": "node scripts/check-admin-flow.mjs",
    "check:content": "node scripts/check-content-crud.mjs",
    "check:notifications": "node scripts/check-notifications.mjs"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "supabase": "^1.207.9",
    "typescript": "^5.6.3"
  }
}