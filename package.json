{
  "name": "abide",
  "private": true,
  "packageManager": "pnpm@9.14.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "dev": "node scripts/dev.mjs",
    "dev:all": "node scripts/dev.mjs",
    "dev:stop": "node scripts/dev-stop.mjs",
    "emu": "node scripts/emulator.mjs",
    "emu:reload": "node scripts/emulator.mjs reload",
    "emu:shot": "node scripts/emulator.mjs shot",
    "emu:logs": "node scripts/emulator.mjs logs",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint",
    "check:offline": "node scripts/check-offline-sync.mjs",
    "dev:reset": "pnpm db:reset && pnpm --filter @abide/content content:import && node scripts/seed-demo-progress.mjs",
    "dev:demo": "node scripts/seed-demo-progress.mjs",
    "dev:members": "node scripts/seed-mock-members.mjs",
    "content:import": "pnpm --filter @abide/content content:import",
    "check:admin": "node scripts/check-admin-flow.mjs",
    "check:content": "node scripts/check-content-crud.mjs",
    "check:notifications": "node scripts/check-notifications.mjs",
    "notify:plan": "node scripts/plan-notifications.mjs",
    "notify:send": "node scripts/send-notifications.mjs",
    "check:fcm": "node scripts/check-fcm-credentials.mjs",
    "bible:build": "node --disable-warning=ExperimentalWarning scripts/build-bible.mjs",
    "bible:list": "node --disable-warning=ExperimentalWarning scripts/build-bible.mjs --list",
    "check:bible-refs": "node --disable-warning=ExperimentalWarning scripts/check-bible-refs.mjs"
  },
  "devDependencies": {
    "pixelmatch": "5",
    "pngjs": "7",
    "prettier": "^3.3.3",
    "supabase": "^1.207.9",
    "typescript": "^5.6.3"
  }
}
