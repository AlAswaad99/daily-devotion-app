node_modules/
dist/
.expo/
.next/
*.tsbuildinfo
.env
.env.local
.DS_Store
supabase/.branches/
supabase/.temp/

# Credentials — Firebase service account, and the Android config that carries the
# project's API key. Never committed.
secrets/*
!secrets/README.md
# Any copy, anywhere — `expo prebuild` writes one into android/app/ as well.
**/google-services.json
**/GoogleService-Info.plist

# Generated by `expo prebuild` / `expo run:android`. The config lives in
# app.json and app.config.ts; these directories are build output and are
# regenerated on demand.
apps/mobile/android/
apps/mobile/ios/

# Holds the Firebase service account for local `functions serve`.
supabase/functions/.env

# Generated by Next 16 on every dev run (next.config `agentRules`).
apps/admin/AGENTS.md
apps/admin/CLAUDE.md

# Built from the copyrighted scripture XML — never committed, never shipped
# until gate 1 clears. Rebuild with: node scripts/build-bible.mjs
apps/mobile/assets/bible/

# Gradle output for the local native modules (the app's own android/ is already ignored).
apps/mobile/modules/*/android/build/
apps/mobile/modules/*/android/.cxx/

# Emulator screenshots and other local scratch output.
.scratch/
