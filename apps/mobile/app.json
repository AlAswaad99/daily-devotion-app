{
  "expo": {
    "name": "Temuagn",
    "slug": "temuagn",
    "scheme": "temuagn",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "org.temuagn.app"
    },
    "android": {
      "package": "org.temuagn.app"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications"
    ]
  }
}
