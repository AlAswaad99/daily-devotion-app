# Local Supabase. `supabase start` prints the anon key — paste it here.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The bot a member activates to receive their sign-in code — see docs/telegram-bot.md.
# The @username Telegram shows for it, without the @.
EXPO_PUBLIC_TELEGRAM_BOT_USERNAME=
